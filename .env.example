# Absolute origin the site is served from. Used for canonical URLs, hreflang,
# the sitemap and OpenGraph image URLs.
NEXT_PUBLIC_SITE_URL=https://certitrackplus.com

# Only set for a GitHub *project* page (https://user.github.io/repo).
# Leave blank for a custom domain.
NEXT_PUBLIC_BASE_PATH=

# --- Screenshot capture (npm run screens) ----------------------------------
# Used ONLY by scripts/capture-screens.mjs, on your machine. Put the real
# values in .env.local, which is gitignored. Log in as a DEMO tenant: whatever
# this account sees ends up on a public web page.
CERTITRACK_URL=https://certitrackplus.com
CERTITRACK_EMAIL=
CERTITRACK_PASSWORD=
